{
	"name": "tsumugi-lib",
	"private": true,
	"version": "0.0.0",
	"description": "monorepo",
	"type": "module",
	"imports": {
		"#svgx/jsx-runtime": "./pages/svgx/jsx-runtime.ts",
		"#svgx/jsx-dev-runtime": "./pages/svgx/jsx-runtime.ts"
	},
	"scripts": {
		"manifest": "tsx ./scripts/manifest.ts",
		"lint": "tsx ./scripts/index.ts --lint",
		"build": "tsx ./scripts/index.ts --build",
		"skill": "tsx ./scripts/index.ts --skill",
		"pub": "tsx ./scripts/index.ts --publish",
		"test": "tsx ./scripts/index.ts --test",
		"cover": "pnpm -r --if-present run cover",
		"svg": "tsx --tsconfig ./pages/tsconfig.json ./pages/plugins/src/rollup-plugin-table.tsx"
	},
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-replace": "^6.0.3",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.5",
		"oxlint": "^1.61.0",
		"prettier": "^3.8.3",
		"rollup-plugin-func-macro": "^1.2.3",
		"tsdown": "^0.22.14",
		"tslib": "^2.8.1",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"is-wsl": "^3.1.1"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
