{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "declaration": false,
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "./pages/svgx/runtime.ts",
    "paths": {
      "@shared/*": ["../_shared/*"]
    }
  },
  "include": ["*.config.ts", "scripts/**/*.ts", "rollup.config.ts"]
}
