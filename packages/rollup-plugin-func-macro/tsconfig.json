{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "declaration": false, // false to let rollup handle it
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts", "./tests/**/*.ts"]
}
