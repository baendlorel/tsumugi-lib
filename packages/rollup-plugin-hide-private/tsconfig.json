  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "declaration": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "strict": true,
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts", "./tests/**/*.ts"]
}
