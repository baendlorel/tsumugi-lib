{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "stripInternal": true,
    "paths": {
      "@shared": ["../_shared/index.ts"],
      "@duo-map": ["../duo-map/src/index.ts"],
      "@shared/*": ["../_shared/*"]
    }
  },
  "include": ["src/**/*.ts", "implements/**/*.ts"]
}
