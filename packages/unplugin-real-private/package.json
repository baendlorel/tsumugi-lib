{
  "name": "unplugin-real-private",
  "version": "0.0.1",
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "description": "Turn TypeScript private class members into real ECMAScript #private members, for Vite, Rollup, Webpack, Rspack, esbuild and more.",
  "description_zh": "把 TypeScript 的 private 类成员变成真正的 #私有成员，支持 Vite / Rollup / Webpack / Rspack / esbuild 等所有 unplugin 适配的打包工具。",
  "purpose": "unplugin",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/baendlorel/kt-packages/tree/main/packages/unplugin-real-private#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baendlorel/kt-packages.git",
    "directory": "packages/unplugin-real-private"
  },
  "keywords": [
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "rspack",
    "esbuild",
    "plugin",
    "typescript",
    "javascript",
    "private",
    "class",
    "members"
  ],
  "license": "MIT",
  "dependencies": {
    "magic-string": "^0.30.21",
    "unplugin": "^3.4.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "bugs": {
    "url": "https://github.com/baendlorel/kt-packages/issues"
  }
}
